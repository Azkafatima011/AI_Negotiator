# Alibaba Cloud Configuration (Production)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_secret
ALIBABA_CLOUD_REGION=ap-south-1

# Alibaba Cloud Model Studio / Qwen
ALIBABA_MODEL_STUDIO_API_KEY=your_model_studio_key
ALIBABA_MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen-plus

# WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Alibaba.com Open Platform
ALIBABA_COM_APP_KEY=your_app_key
ALIBABA_COM_APP_SECRET=your_app_secret

# Database
DATABASE_URL=sqlite:///./negotiation.db

# Security
SECRET_KEY=your-jwt-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application
APP_NAME=AI Negotiator
DEBUG=true
